# Master values. Use URL-encoded secrets in DSNs. MASTER_BIND can be your Tailscale IP.
# LINUXCK_SERVER_IMAGE=bachcp10/linuxck-server:0.1.0-rc.1
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
POSTGRES_DSN=
MASTER_ADDRESS=
MASTER_BIND=127.0.0.1
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WORKER_TIMEOUT=25
FRESHNESS_SECONDS=90
COMPARISON_WINDOW=60
# Worker values. Set WORKER_ID and EXCHANGE per machine.
# LINUXCK_WORKER_IMAGE=bachcp10/linuxck-worker:0.1.0-rc.1
WORKER_ID=worker-2
EXCHANGE=binance
COLLECT_INTERVAL=60
