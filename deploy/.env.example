# Master values. Use URL-encoded secrets in DSNs. MASTER_BIND can be your Tailscale IP.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
POSTGRES_DSN=
MASTER_ADDRESS=
MASTER_BIND=127.0.0.1
TELEGRAM_ENABLED=false
WORKER_TIMEOUT=25
FRESHNESS_SECONDS=90
COMPARISON_WINDOW=60
# Worker values. Set WORKER_ID and EXCHANGE per machine.
WORKER_ID=worker-2
EXCHANGE=binance
COLLECT_INTERVAL=60
